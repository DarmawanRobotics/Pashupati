<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup: staged full-stack launch, RViz config, and a tmuxp session for the whole Pashupati robot.</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_drivers</exec_depend>
  <exec_depend>robot_ui</exec_depend>
  <exec_depend>robot_mapping</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_perception</exec_depend>
  <exec_depend>robot_navigation</exec_depend>
  <exec_depend>robot_mission</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
