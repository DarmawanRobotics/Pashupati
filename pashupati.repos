# The Dharma stack Pashupati runs on: vcs import src < pashupati.repos
# (scripts/setup.sh install dharma). Every repository is pinned to a commit; the comment names
# the release or the day of the main commit. Livox and FAST-LIO are submodules in src/xtras.
repositories:
  dharma/dharma_utils:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_utils.git
    version: 8d0472301cea83651c176288df4bf344a87199eb # main 2026-10-30
  dharma/dharma_interfaces:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_interfaces.git
    version: c04650b4bc08288bfea2fac7d0f432befbb9ea9f # feat/trip 2026-11-14 (TripStatus)
  dharma/dharma_odometry:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_odometry.git
    version: b3398530de5d9d70a0d8ed6bd7d1d3f91ebae9cc # feat/trip 2026-11-14 (trip meter)
  dharma/dharma_localization:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_localization.git
    version: f9e1a9564cc7b3e3cda3235af10e80bcd55d54df # main 2026-10-28
  dharma/dharma_perception:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_perception.git
    version: 94fadf33d12ecc9ca0831d171a1f258a60754d5d # feat/depth-obstacles 2026-11-14 (depth camera obstacles)
  dharma/dharma_mapping:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_mapping.git
    version: 8e322baf88739c8e5adf4aae79385e791aa783c4 # main 2026-10-28
  # dharma_navigation and dharma_control
