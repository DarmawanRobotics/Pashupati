    url: git@github.com:DarmawanRobotics/dharma_navigation.git
    version: e1d09c966b5ca6ea1faec28524d0a45bfabb32cf # feat/path-shift-detour 2026-11-14 (detours)
  dharma/dharma_health:
    type: git
    url: git@github.com:DarmawanRobotics/dharma_health.git
    version: dc48db6257d1dd1bf635c6338f06d4abf97558a9 # main 2026-10-28
