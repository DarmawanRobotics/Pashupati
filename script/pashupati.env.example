# /etc/pashupati/pashupati.env — read by pashupati.service (script/run_robot.sh)
# Tuning parameters belong in SITE_CONFIG (see src/pashupati/config/site.example.yaml).
ROBOT_ID=l1w-01
# MODE: patrol | teach    ODOMETRY: fast_lio | leg_kilo
# (systemd reads this file: no comments after a value, they become part of it)
MODE=patrol
ODOMETRY=fast_lio
ROUTE=
TAGS=/home/robot/dev/Pashupati/map/tag_config.json
ROBOT_NS=l1w
ROS_DOMAIN_ID=0
PEOPLE=true
INSPECTION=true
SITE_CONFIG=/etc/pashupati/site.yaml
# NETRA command center (Pengaturan -> Robot -> Tambah gives the token)
CC_URL=
CC_TOKEN=
