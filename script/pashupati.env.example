# /etc/pashupati/pashupati.env — read by pashupati.service (script/run_robot.sh)
# Tuning parameters belong in SITE_CONFIG (see src/pashupati/config/site.example.yaml).
ROBOT_ID=robot-01
# Robot package (driver, URDF, sensors), see src/xtras/README.md: <package>[/<file>.launch.py]
ROBOT_BRINGUP=
# Namespace of the robot driver topics and services (/<ROBOT_NS>/cmd_vel, ...)
ROBOT_NS=robot
# Optional command run before the stack starts, e.g. to stop a vendor autostart
ROBOT_PRESTART=
# MODE: patrol | teach    ODOMETRY: fast_lio | leg_kilo
# (systemd reads this file: no comments after a value, they become part of it)
MODE=patrol
ODOMETRY=fast_lio
ROUTE=
TAGS=/home/robot/dev/Pashupati/map/tag_config.json
ROS_DOMAIN_ID=0
PEOPLE=true
INSPECTION=true
SITE_CONFIG=/etc/pashupati/site.yaml
# NETRA command center (Pengaturan -> Robot -> Tambah gives the token)
CC_URL=
CC_TOKEN=
# One OpenBLAS/OpenMP thread per node: more threads busy-wait and burn whole cores
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
